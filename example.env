SHOPIFY_STORE_DOMAIN={shop}.myshopify.com
SHOPIFY_ADMIN_API_ACCESS_TOKEN=shpat_...paste_yours...
SHOPIFY_API_VERSION=2025-01
PRODUCT_CATALOG_PATH=./data/products.json
TEXT_INDEX_PATH=./data/text_index.json
TOP_K_RESULTS=5
EXCLUDE_OUT_OF_STOCK=true

# Phase 6 — conversation memory (user+assistant turn pairs to retain)
MEMORY_WINDOW_TURNS=6

# Phase 6 — multimodal rank fusion (RRF)
FUSION_RRF_K=60
FUSION_TEXT_WEIGHT=1.0
FUSION_IMAGE_WEIGHT=1.0

CHROMA_PATH=./chroma_db
IMAGE_COLLECTION_NAME=shopify_images

# Whisper (Phase 4) — tiny | base | small | medium
WHISPER_MODEL=base

# CLIP (Phase 5)
CLIP_MODEL=ViT-B/32

# LLM (Phase 2)
LLM_PROVIDER=groq    # groq or gemini
GROQ_API_KEY=gsk_...paste_yours...
GROQ_MODEL=llama-3.1-8b-instant

# Gemini fallback
GOOGLE_API_KEY=AIza...paste_yours...
GEMINI_MODEL=gemini-1.5-flash

# LangSmith (Phase 3 — tracing enabled by default)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_...paste_yours...
LANGCHAIN_PROJECT=SmartShop

# Chainlit frontend (Phase 7)
BACKEND_SEARCH_URL=http://127.0.0.1:8781/api/search
CHAINLIT_REQUEST_TIMEOUT_SECONDS=90

# Phase 8 — deployment (Docker / Hugging Face Spaces)
# BACKEND_HOST=0.0.0.0
# BACKEND_PORT=8781
# CHAINLIT_HOST=0.0.0.0
# CHAINLIT_PORT=7860
